# Bu dosyayı ".env" adıyla kopyala ve değerleri değiştir:  cp .env.example .env
# .env git'e GİRMEZ (.gitignore), .env.example ise girer: hangi değişkenlerin gerektiğini gösterir.
POSTGRES_DB=taskmanager
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=degistir-beni
POSTGRES_PORT=5433

# ---- Production compose (docker-compose.prod.yml) için ----
# JWT imza anahtarı: GİZLİ, en az 32 bayt. Üretmek için: openssl rand -base64 64
JWT_SIGNING_KEY=degistir-beni-en-az-32-bayt-uzunlugunda-rastgele-bir-deger
# Dışarıya açılacak web portu
WEB_PORT=8080
